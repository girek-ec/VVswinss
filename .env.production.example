# EJEMPLO ÚNICAMENTE · NO ES UN .env FUNCIONAL | EXAMPLE ONLY
# Para el VPS crea .env con credenciales reales, nunca lo subas a GitHub.
# Valores de producción orientados a Nginx Proxy Manager (HTTPS).
SECRET_KEY=REEMPLAZAR_CON_CLAVE_DJANGO_SEGURA_GENERADA_EN_EL_SERVIDOR
DEBUG=False
ALLOWED_HOSTS=vvswiss-services.ch,www.vvswiss-services.ch
CSRF_TRUSTED_ORIGINS=https://vvswiss-services.ch,https://www.vvswiss-services.ch
SITE_URL=https://vvswiss-services.ch
DEFAULT_LANGUAGE=fr
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
DB_ENGINE=django.db.backends.postgresql
DB_NAME=vvswinss
DB_USER=vvswinss_user
DB_PASSWORD=REEMPLAZAR_CON_PASSWORD_DB_SEGURA
DB_HOST=postgres
DB_PORT=5432
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=REEMPLAZAR_SMTP_HOST
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=REEMPLAZAR_USUARIO_CORREO
EMAIL_HOST_PASSWORD=REEMPLAZAR_PASSWORD_CORREO
DEFAULT_FROM_EMAIL="V&V Swiss Services <info@vvswiss-services.ch>"
EMAIL_TIMEOUT=10
WHITENOISE_MAX_AGE=86400
