# ============================================================
# VVswinss - Environment Variables Example
# ============================================================

# Django
DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=127.0.0.1,localhost

# Database
DB_ENGINE=django.db.backends.postgresql
DB_NAME=vvswinss
DB_USER=vvswinss_user
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Email
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

DEFAULT_FROM_EMAIL=
CONTACT_EMAIL=

# Site
SITE_URL=http://127.0.0.1:8000
DEFAULT_LANGUAGE=fr
